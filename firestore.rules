rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProperty(propertyId) {
      return signedIn()
        && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }

    function ownsActiveProperty(propertyId) {
      return ownsProperty(propertyId)
        && get(/databases/$(database)/documents/properties/$(propertyId)).data.get('isDeleting', false) != true;
    }

    function ownsPropertyAfter(propertyId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/properties/$(propertyId)).data.get('isDeleting', false) != true;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

      match /profiles/{userId} {
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'owner'
          && request.resource.data.subscriptionPlan == 'free';
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if isAdmin()
          || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.subscriptionPlan == resource.data.subscriptionPlan
            && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus);
      }

    match /properties/{propertyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.get('isDeleting', false) != true
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /guide_sections/{documentId} {
      allow create: if ownsActiveProperty(request.resource.data.propertyId);
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /property_amenities/{documentId} {
      allow create: if ownsActiveProperty(request.resource.data.propertyId);
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /equipment_guides/{documentId} {
      allow create: if ownsActiveProperty(request.resource.data.propertyId);
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /property_house_rules/{documentId} {
      allow create: if ownsActiveProperty(request.resource.data.propertyId);
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /property_faqs/{documentId} {
      allow create: if ownsActiveProperty(request.resource.data.propertyId);
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /nearby_places/{documentId} {
      allow create: if ownsActiveProperty(request.resource.data.propertyId);
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /reservations/{documentId} {
      allow create: if ownsActiveProperty(request.resource.data.propertyId);
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /guide_events/{documentId} {
      allow create: if request.resource.data.eventType in ['view', 'qr_scan']
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('isDeleting', false) != true
        && request.resource.data.ownerId == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId;
      allow read: if ownsProperty(resource.data.propertyId) || isAdmin();
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /guide_reviews/{documentId} {
      allow create: if signedIn()
        && request.resource.data.propertyId is string
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('isDeleting', false) != true
        && request.resource.data.ownerId == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5;
      // A traveller can retrieve their own rating after refreshing the guide,
      // while the owner retains access to every rating for their property.
      // The explicit ownerId branch also lets Firestore prove the owner query
      // used by the dashboard (`where('ownerId', '==', uid)`) is safe.
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid)
        || ownsProperty(resource.data.propertyId)
        || isAdmin()
        || (signedIn() && resource.data.guestId == request.auth.uid);
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /guide_messages/{messageId} {
      // Guests are authenticated anonymously, so they can only access their
      // own conversation while the property owner can moderate every message.
      allow create: if signedIn()
        && request.resource.data.propertyId is string
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('isDeleting', false) != true
        && request.resource.data.ownerId == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && ((request.resource.data.senderRole == 'guest'
          && request.resource.data.guestId == request.auth.uid)
          || (request.resource.data.senderRole == 'owner'
            && ownsProperty(request.resource.data.propertyId)));
      // `ownerId` is validated against the property owner at creation time.
      // Checking it directly here lets Firestore authorize the real-time
      // `where('ownerId', '==', uid)` query used by the owner inbox.
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.guestId == request.auth.uid);
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /public_guides/{guideToken} {
      // A draft may be prepared in this mirror, but it must never be readable
      // through a public URL until its owner explicitly publishes it. A guide
      // issued for a reservation also stops being readable after its checkout.
      allow list: if ownsProperty(resource.data.propertyId);
      allow get: if ownsProperty(guideToken) || (exists(/databases/$(database)/documents/properties/$(resource.data.propertyId))
          && get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.get('isDeleting', false) != true
          && resource.data.status == 'published'
          && (!resource.data.keys().hasAll(['accessExpiresAt'])
            || resource.data.accessExpiresAt == null
            || request.time < resource.data.accessExpiresAt))
        || ownsProperty(resource.data.propertyId)
        || isAdmin();
      // A reservation gets its own random guide token while still being tied
      // to the owner's real property through `propertyId`.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (ownsActiveProperty(request.resource.data.propertyId)
          || ownsPropertyAfter(request.resource.data.propertyId));
      allow update: if ownsActiveProperty(resource.data.propertyId);
      allow delete: if ownsProperty(resource.data.propertyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

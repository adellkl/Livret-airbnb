NEXT_PUBLIC_FIREBASE_API_KEY=
# For production redirect sign-in with the /__/auth proxy, set this to the app's own hostname.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Accès serveur pour les liens d'authentification, le suivi d'envoi et l'administration.
# Ne jamais préfixer ces variables par NEXT_PUBLIC ni les exposer au navigateur.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative : fournir le JSON complet du compte de service dans cette variable.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Envoi centralisé depuis monlivret.1@gmail.com (serveur uniquement).
# Mot de passe d'application Google, à saisir comme secret dans Vercel.
GMAIL_APP_PASSWORD=
# Compatibilité ESM Firebase Admin dans les fonctions Vercel Node 22 (Config / Production).
NODE_OPTIONS=--experimental-require-module

# Domaine public canonique fonctionnel (sans URL de preview).
# Pour les emails, une valeur vide utilise VERCEL_PROJECT_PRODUCTION_URL sur Vercel.
NEXT_PUBLIC_APP_URL=https://monlivret.eu
# false sur un environnement de test ; production seule indexable par défaut
SEO_INDEXABLE=true
# Codes de validation fournis par les moteurs (facultatifs)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state
supabase/.temp/

# Safe environment template
!.env.example

# Editor temporary files
*.swp
*.swo
*~
.idea/

# Credentials and local Firebase state
*.key
*.p12
*.pfx
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
.firebase/
*-debug.log
